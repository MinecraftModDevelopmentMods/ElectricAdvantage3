<!--
  Electric Oven: cooks food from the smelting recipes whose result is food, at 4 FE per tick for 100 ticks
  (FoodSmeltingRecipes). Install an Item Output Port in the output group to push cooked food into neighbours.

  Save compatibility with 3.0: items stay under "Items", input slot first, then output, as 3.0 saved them.
  Buffered energy and cooking progress from 3.0 are not carried over.
-->
<machine xmlns="https://moddev.zone/mmdlib/machine" version="1"
         extends="mmdlib:base_powered_machine" name="Electric Oven">
  <block hardness="3"/>
  <appearance preset="model" model="electricadvantage:block/electric_machine_casing">
    <part id="front_on" model="electricadvantage:block/electric_oven_front_on"
          when="$processors.oven.status == 'running'"/>
    <part id="front_powered" model="electricadvantage:block/electric_oven_front_powered"
          when="$processors.oven.status != 'running' &amp;&amp; $energy.energy.stored &gt;= 4"/>
    <part id="front_off" model="electricadvantage:block/electric_oven_front_off"
          when="$processors.oven.status != 'running' &amp;&amp; $energy.energy.stored &lt; 4"/>
  </appearance>
  <storage>
    <energy id="energy" capacity="500" input-rate="4096"/>
    <items id="Items">
      <slots id="input" name="Food" count="1" role="input"/>
      <slots id="output" name="Cooked Food" count="1" role="output"/>
    </items>
  </storage>
  <recipe-type id="electricadvantage:oven_cooking" declare="true" name="Electric Oven">
    <generator class="zone.moddev.mc.electricadvantage.processing.FoodSmeltingRecipes"
               time="100" energy-per-tick="4"/>
  </recipe-type>
  <processor id="oven" recipe-type="electricadvantage:oven_cooking"/>
</machine>
