<!--
  Photovoltaic Generator: up to 5.14 FE per tick in full sun, less in rain or thunder, a little from block light under
  a roof (SolarProcessor). It pushes its buffer into neighbouring conduits and machines. Comparators read the output as
  a share of full sun.

  Save compatibility with 3.0 and 3.1: 3.0's "Energy" key loads into the buffer.
-->
<machine xmlns="https://moddev.zone/mmdlib/machine" version="1"
         extends="mmdlib:base_powered_machine" name="Photovoltaic Generator">
  <block hardness="3"/>
  <appearance preset="model" model="electricadvantage:block/photovoltaic_panel"/>
  <storage>
    <energy id="energy" capacity="1000" input-rate="0" output-rate="4096"/>
  </storage>
  <redstone comparator-source="generator/output"/>
  <processor id="solar" class="zone.moddev.mc.electricadvantage.generation.SolarProcessor"/>
</machine>
